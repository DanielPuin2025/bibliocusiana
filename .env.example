# =====================================================
# Configuración de Variables de Entorno
# Sistema de Biblioteca - Bibliocusiana
# =====================================================

# =====================================================
# BASE DE DATOS
# =====================================================
DB_HOST=localhost
DB_NAME=biblioteca_db
DB_USER=root
DB_PASSWORD=

# =====================================================
# WHATSAPP BUSINESS API - Meta (Facebook)
# =====================================================
# Para obtener estos valores, debes:
# 1. Crear una cuenta de Meta for Developers: https://developers.facebook.com/
# 2. Crear una aplicación de WhatsApp Business
# 3. Configurar el número de teléfono de WhatsApp Business
# 4. Crear una plantilla de mensaje aprobada por Meta

# Token de acceso permanente de la API de WhatsApp
WHATSAPP_ACCESS_TOKEN=tu_token_aqui

# ID del número de teléfono de WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=tu_id_de_numero_aqui

# Nombre de la plantilla de mensaje aprobada en Meta
# Ejemplo de plantilla "recordatorio_biblioteca":
# Hola, te recordamos que el libro "{{1}}" debe ser devuelto el {{2}}.
# Faltan {{3}} días. ¡Gracias por usar la biblioteca!
WHATSAPP_TEMPLATE_NAME=recordatorio_biblioteca

# Versión de la API de WhatsApp Business
WHATSAPP_API_VERSION=v17.0

# =====================================================
# CONFIGURACIÓN DE CORREO (SMTP)
# =====================================================
# Ya está configurado en backend/config/correo.php
# Verifica que PHPMailer esté correctamente configurado

# =====================================================
# INSTRUCCIONES DE USO
# =====================================================
# 1. Configura estos valores como variables de entorno en el servidor.
# 2. No subas credenciales ni archivos .env al repositorio.
# 3. PHP no carga este archivo automáticamente.

# =====================================================
# CONFIGURACIÓN EN APACHE (Alternativa al .env)
# =====================================================
# Si prefieres no usar archivo .env, puedes configurar
# las variables directamente en Apache:
#
# En httpd.conf o en .htaccess agrega:
# SetEnv WHATSAPP_ACCESS_TOKEN "tu_token"
# SetEnv WHATSAPP_PHONE_NUMBER_ID "tu_id"
# SetEnv WHATSAPP_TEMPLATE_NAME "recordatorio_biblioteca"
# SetEnv WHATSAPP_API_VERSION "v17.0"
#
# Luego reinicia Apache

# =====================================================
# VERIFICAR CONFIGURACIÓN
# =====================================================
# Para verificar que las variables están cargadas:
# Crea un archivo test_env.php con:
# <?php
# echo "TOKEN: " . getenv('WHATSAPP_ACCESS_TOKEN') . "\n";
# echo "PHONE_ID: " . getenv('WHATSAPP_PHONE_NUMBER_ID') . "\n";
# echo "TEMPLATE: " . getenv('WHATSAPP_TEMPLATE_NAME') . "\n";
# echo "VERSION: " . getenv('WHATSAPP_API_VERSION') . "\n";
# ?>
